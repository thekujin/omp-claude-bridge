{
	"name": "omp-claude-bridge",
	"version": "0.8.1",
	"private": false,
	"description": "Oh My Pi extension that runs Claude Code through the Claude Agent SDK as a model provider.",
	"keywords": [
		"omp-package",
		"oh-my-pi",
		"extension",
		"claude-code",
		"claude-agent-sdk",
		"context-window",
		"1m-context"
	],
	"author": "Jonathan Borgwing (https://github.com/DevVig)",
	"contributors": [
		"Eli Dickinson (original pi-claude-bridge author, https://github.com/elidickinson)"
	],
	"license": "MIT",
	"homepage": "https://github.com/DevVig/omp-claude-bridge#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DevVig/omp-claude-bridge.git"
	},
	"bugs": {
		"url": "https://github.com/DevVig/omp-claude-bridge/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"NOTICE",
		"tsconfig.json",
		"assets"
	],
	"scripts": {
		"test": "bun test ./tests",
		"test:unit": "bun test ./tests",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun run test"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.293",
		"cc-session-io": "^0.3.1",
		"change-case": "^5.4.4",
		"typebox": "^1.3.6",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^0.80.10",
		"@earendil-works/pi-coding-agent": "^0.80.10",
		"@earendil-works/pi-tui": "^0.80.10",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.1",
		"typescript": "^5.9.3"
	},
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	}
}
